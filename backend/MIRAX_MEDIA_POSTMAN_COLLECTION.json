{
  "info": {
    "_postman_id": "mirax-media-api-collection",
    "name": "MIRAX MEDIA — Backend API Collection",
    "description": "Complete production API test collection for MIRAX MEDIA backend with Neon PostgreSQL, Zod validation, and protected admin endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "adminApiKey",
      "value": "mirax_admin_secret_key_2026",
      "type": "string"
    },
    {
      "key": "contactId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Public — Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/health",
          "host": ["{{baseUrl}}"],
          "path": ["api", "health"]
        },
        "description": "Checks backend status and verifies active Neon PostgreSQL database connectivity."
      }
    },
    {
      "name": "2. Public — Submit Customer Enquiry",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"Vimal Kumar\",\n  \"email\": \"vimal.growth@example.com\",\n  \"phone\": \"+91 98765 43210\",\n  \"companyName\": \"ABC Digital Labs\",\n  \"service\": \"SEO Services\",\n  \"budget\": \"₹25,000 - ₹50,000\",\n  \"message\": \"We are looking to scale our organic search traffic and optimize product pages for high intent keywords.\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/contact",
          "host": ["{{baseUrl}}"],
          "path": ["api", "contact"]
        },
        "description": "Validates customer lead with Zod, saves to Neon PostgreSQL contacts table, and triggers asynchronous Nodemailer confirmation and admin alert emails."
      }
    },
    {
      "name": "3. Public — Test Zod Validation Rejection (Invalid Email & Phone)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"V\",\n  \"email\": \"not-a-valid-email\",\n  \"phone\": \"12\",\n  \"service\": \"\",\n  \"message\": \"hi\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/contact",
          "host": ["{{baseUrl}}"],
          "path": ["api", "contact"]
        },
        "description": "Tests validation guardrails. Returns HTTP 400 Bad Request with field-by-field error breakdown."
      }
    },
    {
      "name": "4. Admin — Get All Enquiries (Protected)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminApiKey}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/admin/contacts?page=1&limit=10&status=NEW",
          "host": ["{{baseUrl}}"],
          "path": ["api", "admin", "contacts"],
          "query": [
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "limit",
              "value": "10"
            },
            {
              "key": "status",
              "value": "NEW"
            }
          ]
        },
        "description": "Returns paginated list of client leads from Neon PostgreSQL. Requires Bearer token or x-admin-key header."
      }
    },
    {
      "name": "5. Admin — Get Enquiry By ID (Protected)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "x-admin-key",
            "value": "{{adminApiKey}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/admin/contacts/{{contactId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "admin", "contacts", "{{contactId}}"]
        },
        "description": "Retrieves full details of a specific enquiry by UUID."
      }
    },
    {
      "name": "6. Admin — Update Enquiry Status (Protected)",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminApiKey}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"CONTACTED\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/admin/contacts/{{contactId}}/status",
          "host": ["{{baseUrl}}"],
          "path": ["api", "admin", "contacts", "{{contactId}}", "status"]
        },
        "description": "Updates status to one of: NEW, CONTACTED, IN_PROGRESS, COMPLETED, REJECTED."
      }
    },
    {
      "name": "7. Admin — Delete Enquiry (Protected)",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminApiKey}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/admin/contacts/{{contactId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "admin", "contacts", "{{contactId}}"]
        },
        "description": "Permanently deletes an enquiry by UUID."
      }
    }
  ]
}
